rules_version = '2';

// FinSist — Firestore rules
//
// Model: 1 user ↔ 1 household. Household members[].userId is mirrored to
// memberIds[] for `request.auth.uid in array` checks. Per-member access
// tier is mirrored to `memberAccess: {<uid>: 'full'|'limited'}` for
// O(1) rule lookups. Both arrays + map kept in sync on join/leave.
//
// Trust model: publicly reachable (Cloudflare Pages + GH Release APKs).
// Privacy boundary is the household: members see each other's data; the
// `limited` tier additionally cannot see account balances (SEC-004).
//
// Reads:
//   - households: `get` allowed for members only. Joiner validates an invite
//     via the invite doc (which carries preview fields), so the household
//     root never needs to be public-readable.
//   - households/{hid}/private/balances: `full`-tier only. SEC-004 privacy.
//   - invites: `get` allowed for any authed user (the 128-bit token doc id
//     IS the credential; guessing is infeasible). `list` blocked.
//   - other per-household subcollections: members only.
//
// Writes (per access tier):
//   - full    → all writes (settings, members, balances, expenses, incomes,
//               cards, goals, investments).
//   - limited → expenses + incomes + transfers only. NO balance reads/writes,
//               NO cards/goals/investments/settings. Recorded expenses skip
//               the balance side-effect (UI hides the account picker).
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user profile. Only the owner reads/writes their own doc.
    // Exception: `removeMember` (creator-only, app code) and `leave` set
    // `users/{uid}.householdId`. We still tighten this to owner-only;
    // the removed user's doc is cleaned up by the app on next sign-in
    // (see `currentUserDocProvider`).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /households/{hid} {
      // `get` is members-only. Non-members never need to read the household
      // root: invite preview fields (householdName, inviterDisplayName) live
      // on the invite doc so the join confirmation UI works without root
      // access. `list` is blocked: no global household enumeration.
      allow get: if request.auth != null
                 && request.auth.uid in resource.data.memberIds;
      allow list: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.creatorId
                    && request.auth.uid in request.resource.data.memberIds;

      // Existing-member update.
      // - `limited` → blocked. They cannot touch the root doc (no settings,
      //                members, or categories). Their balance writes happen
      //                on `private/balances` (denied — full-only) so they
      //                effectively cannot mutate the root at all.
      // - `full`    → allowed.
      // Self-edit profile (members[<self>]) currently requires `full`.
      // Internal-team scope (2–5 users) makes this acceptable.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && resource.data.memberAccess[request.auth.uid] == 'full';

      // Non-member self-join: must add only themselves AND reference a valid,
      // unconsumed invite for THIS household. The `claimedInvite` field on
      // the household carries the code so the rule can resolve the invite.
      // `getAfter` requires the same transaction to also consume the invite
      // (binding `consumedBy` to the caller) — otherwise the code could be
      // re-used by other joiners.
      //
      // The joiner's access level is pinned to the invite's `accessLevel`
      // via `memberAccess.<uid>` — the joiner cannot escalate by passing
      // 'full' instead.
      allow update: if request.auth != null
                    && !(request.auth.uid in resource.data.memberIds)
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() ==
                       resource.data.memberIds.size() + 1
                    && request.resource.data.creatorId == resource.data.creatorId
                    && request.resource.data.claimedInvite is string
                    && exists(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.householdId == hid
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.consumed == false
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.expiresAt > request.time
                    && request.resource.data.memberAccess[request.auth.uid] ==
                       get(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.accessLevel
                    && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.consumed == true
                    && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.consumedBy == request.auth.uid;

      // Last-leaver delete: only the sole remaining member may delete the
      // household root (also requires full access).
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && resource.data.memberAccess[request.auth.uid] == 'full';

      // Helpers for subcollection rules.
      function household() {
        return get(/databases/$(database)/documents/households/$(hid)).data;
      }
      function isMember() {
        return request.auth != null
               && request.auth.uid in household().memberIds;
      }
      function level() {
        return household().memberAccess[request.auth.uid];
      }
      function canTxn() {
        return level() == 'full' || level() == 'limited';
      }
      function canFull() {
        return level() == 'full';
      }
      // Limited tier can only delete txns they themselves created. Full can
      // delete anything.
      function canDeleteTxn(res) {
        return canFull()
               || (canTxn() && res.data.createdBy == request.auth.uid);
      }
      // Common create-time shape gate for txn-style docs.
      function txnCreateOk() {
        return request.resource.data.amount is number
               && request.resource.data.amount > 0
               && request.resource.data.createdBy == request.auth.uid;
      }
      // Common update-time gate: creator identity is immutable.
      function txnUpdateOk(res) {
        return request.resource.data.amount is number
               && request.resource.data.amount > 0
               && request.resource.data.createdBy == res.data.createdBy;
      }

      // expenses: full + limited can create/update; delete is creator-only
      // for limited. spentBy must be a household member.
      match /expenses/{document=**} {
        allow read: if isMember();
        allow create: if isMember() && canTxn() && txnCreateOk()
                      && request.resource.data.spentBy in household().memberIds;
        allow update: if isMember() && canTxn() && txnUpdateOk(resource)
                      && request.resource.data.spentBy in household().memberIds;
        allow delete: if isMember() && canDeleteTxn(resource);
      }
      // incomes: full + limited can create/update; delete is creator-only.
      // receivedBy must be a household member.
      match /incomes/{document=**} {
        allow read: if isMember();
        allow create: if isMember() && canTxn() && txnCreateOk()
                      && request.resource.data.receivedBy in household().memberIds;
        allow update: if isMember() && canTxn() && txnUpdateOk(resource)
                      && request.resource.data.receivedBy in household().memberIds;
        allow delete: if isMember() && canDeleteTxn(resource);
      }
      // transfers: full + limited; transferredBy must be a household member.
      match /transfers/{document=**} {
        allow read: if isMember();
        allow create: if isMember() && canTxn() && txnCreateOk()
                      && request.resource.data.transferredBy in household().memberIds;
        allow update: if isMember() && canTxn() && txnUpdateOk(resource)
                      && request.resource.data.transferredBy in household().memberIds;
        allow delete: if isMember() && canDeleteTxn(resource);
      }

      // cards + goals + investments: full-tier only for the parent doc.
      match /cards/{cardId} {
        allow read: if isMember();
        allow write: if isMember() && canFull();

        // Installments are debt schedules under a card; full-only.
        match /installments/{installmentId} {
          allow read: if isMember();
          allow write: if isMember() && canFull();
        }
      }
      // Goals: full only for the goal doc itself.
      // Contributions: any household member with txn rights can append;
      // immutable after create — the bar chart is an audit trail.
      match /goals/{goalId} {
        allow read: if isMember();
        allow write: if isMember() && canFull();

        match /contributions/{cid} {
          allow read: if isMember();
          allow create: if isMember() && canTxn()
                        && request.resource.data.amount is number
                        && request.resource.data.amount > 0
                        && request.resource.data.byUid == request.auth.uid;
          allow update, delete: if false;
        }
      }
      match /investments/{document=**} {
        allow read: if isMember();
        allow write: if isMember() && canFull();
      }

      // Net-worth daily snapshots. Doc id pinned to YYYY-MM-DD; any
      // member can record today's snapshot or read history. No delete.
      match /netWorthSnapshots/{date} {
        allow read: if isMember();
        allow create, update: if isMember()
                              && date.matches('^\\d{4}-\\d{2}-\\d{2}$');
        allow delete: if false;
      }

      // SEC-004: cash + savings balances split off the root doc into a
      // private subcollection. Full-tier only — limited members cannot see
      // OR mutate balance values. The `balances` doc is created alongside
      // the household root in `HouseholdRepository.create`.
      match /private/{doc} {
        allow read, write: if isMember() && canFull();
      }
    }

    // Invite codes: 128-bit URL-safe token (single-use). `get` allowed (so a
    // joiner can validate). `list` blocked — no enumeration. Only the
    // generator can create; they must mark it unconsumed. Consume = a single
    // false→true transition that binds `consumedBy` to the caller; immutable
    // fields (householdId, generatedBy, expiresAt) must stay unchanged.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.generatedBy
                    && request.resource.data.consumed == false;

      allow update: if request.auth != null
                    && resource.data.consumed == false
                    && request.resource.data.consumed == true
                    && request.resource.data.consumedBy == request.auth.uid
                    && request.resource.data.householdId == resource.data.householdId
                    && request.resource.data.generatedBy == resource.data.generatedBy
                    && request.resource.data.expiresAt == resource.data.expiresAt;

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.generatedBy;
    }
  }
}
