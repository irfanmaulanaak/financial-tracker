rules_version = '2';

// Financial Tracker — Firestore rules
// Model: 1 user ↔ 1 household. Household members[].userId is mirrored to
// memberIds[] for rule evaluation. Both arrays kept in sync on join/leave.
//
// Trust model: internal app, 2-5 known users, distributed via TestFlight/APK.
// Household root doc is readable by any authed user (so a joiner can validate
// an invite); per-household subcollections (expenses, etc.) remain
// member-gated. Self-join requires the joiner to reference a valid invite
// via the `claimedInvite` field — the rule resolves that to the actual
// invite doc and checks it targets THIS household, is unconsumed, and is
// not expired.
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user profile. Only the owner can read/write.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.creatorId
                    && request.auth.uid in request.resource.data.memberIds;

      // Existing-member update: free-form (subject to subcollection rules).
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberIds;

      // Non-member self-join: must add only themselves AND reference a valid,
      // unconsumed invite for THIS household. The `claimedInvite` field on
      // the household carries the code so the rule can resolve the invite.
      // `getAfter` requires the same transaction to also consume the invite
      // (binding `consumedBy` to the caller) — otherwise the code could be
      // re-used by other joiners.
      allow update: if request.auth != null
                    && !(request.auth.uid in resource.data.memberIds)
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() ==
                       resource.data.memberIds.size() + 1
                    && request.resource.data.creatorId == resource.data.creatorId
                    && request.resource.data.claimedInvite is string
                    && exists(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.householdId == hid
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.consumed == false
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.expiresAt > request.time
                    && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.consumed == true
                    && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.consumedBy == request.auth.uid;

      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.memberIds;

      // All household subcollections (expenses, incomes, cards, goals, etc.)
      // are member-only.
      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in
            get(/databases/$(database)/documents/households/$(hid)).data.memberIds;
      }
    }

    // Invite codes: 6-digit, single-use. Any authed user can read (to validate
    // a code). Only the generator can create; they must mark it unconsumed.
    // Consume = a single false→true transition that binds `consumedBy` to the
    // caller; immutable fields (householdId, generatedBy, expiresAt) must
    // stay unchanged. After consumption no further updates allowed.
    match /invites/{code} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.generatedBy
                    && request.resource.data.consumed == false;

      allow update: if request.auth != null
                    && resource.data.consumed == false
                    && request.resource.data.consumed == true
                    && request.resource.data.consumedBy == request.auth.uid
                    && request.resource.data.householdId == resource.data.householdId
                    && request.resource.data.generatedBy == resource.data.generatedBy
                    && request.resource.data.expiresAt == resource.data.expiresAt;

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.generatedBy;
    }
  }
}
