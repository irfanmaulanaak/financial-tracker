rules_version = '2';

// FinSist — Firestore rules
//
// Model: 1 user ↔ 1 household. Household members[].userId is mirrored to
// memberIds[] for `request.auth.uid in array` checks. Per-member access
// tier is mirrored to `memberAccess: {<uid>: 'full'|'limited'|'view'}` for
// O(1) rule lookups. Both arrays + map kept in sync on join/leave.
//
// Trust model: internal app, 2-5 known users.
//
// Reads:
//   - households: `get` allowed for any authed user (so a joiner can validate
//     a code). `list` blocked — no enumeration of every household.
//   - invites: `get` allowed for any authed user. `list` blocked.
//   - per-household subcollections: members only.
//
// Writes (per access tier):
//   - full    → all writes (settings, members, expenses, incomes, cards,
//               goals, investments).
//   - limited → expenses + incomes only. No settings/cards/goals/investments.
//   - view    → no writes.
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user profile. Only the owner reads/writes their own doc.
    // Exception: `removeMember` (creator-only, app code) and `leave` set
    // `users/{uid}.householdId`. We still tighten this to owner-only;
    // the removed user's doc is cleaned up by the app on next sign-in
    // (see `currentUserDocProvider`).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /households/{hid} {
      // Single-doc reads stay open so a joiner can validate household
      // existence after redeeming an invite. `list` is blocked: no global
      // household enumeration.
      allow get: if request.auth != null;
      allow list: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.creatorId
                    && request.auth.uid in request.resource.data.memberIds;

      // Existing-member update.
      // - `view`     → blocked.
      // - `limited`  → blocked for settings/members/categories.
      //                Allowed for cashAccounts/savingsAccounts ONLY (so
      //                recording an expense or income can decrement / bump
      //                the source/destination account in the same txn).
      //                Subcollection writes are gated separately below.
      // - `full`     → allowed.
      // Self-edit profile (members[<self>]) currently requires `full`.
      // Internal-team scope (2–5 users) makes this acceptable.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && resource.data.memberAccess[request.auth.uid] == 'full';

      // Limited tier: can update only cashAccounts/savingsAccounts (account
      // balance side-effects of recording a txn). All other fields must
      // stay byte-equal to the existing doc.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && resource.data.memberAccess[request.auth.uid] == 'limited'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['cashAccounts', 'savingsAccounts']);

      // Non-member self-join: must add only themselves AND reference a valid,
      // unconsumed invite for THIS household. The `claimedInvite` field on
      // the household carries the code so the rule can resolve the invite.
      // `getAfter` requires the same transaction to also consume the invite
      // (binding `consumedBy` to the caller) — otherwise the code could be
      // re-used by other joiners.
      allow update: if request.auth != null
                    && !(request.auth.uid in resource.data.memberIds)
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() ==
                       resource.data.memberIds.size() + 1
                    && request.resource.data.creatorId == resource.data.creatorId
                    && request.resource.data.claimedInvite is string
                    && exists(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.householdId == hid
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.consumed == false
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.expiresAt > request.time
                    && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.consumed == true
                    && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.claimedInvite))
                         .data.consumedBy == request.auth.uid;

      // Last-leaver delete: only the sole remaining member may delete the
      // household root (also requires full access).
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && resource.data.memberAccess[request.auth.uid] == 'full';

      // Helpers for subcollection rules.
      function household() {
        return get(/databases/$(database)/documents/households/$(hid)).data;
      }
      function isMember() {
        return request.auth != null
               && request.auth.uid in household().memberIds;
      }
      function level() {
        return household().memberAccess[request.auth.uid];
      }
      function canTxn() {
        return level() == 'full' || level() == 'limited';
      }
      function canFull() {
        return level() == 'full';
      }

      // expenses + incomes + transfers: full + limited can write. Each of
      // these flows updates the corresponding subcollection AND the
      // household root's cashAccounts/savingsAccounts in the same txn —
      // the limited-tier root-doc rule above scopes that side-effect.
      match /expenses/{document=**} {
        allow read: if isMember();
        allow write: if isMember() && canTxn();
      }
      match /incomes/{document=**} {
        allow read: if isMember();
        allow write: if isMember() && canTxn();
      }
      match /transfers/{document=**} {
        allow read: if isMember();
        allow write: if isMember() && canTxn();
      }

      // cards + goals + investments: full only.
      match /cards/{document=**} {
        allow read: if isMember();
        allow write: if isMember() && canFull();
      }
      // Goals: full only for the goal doc itself.
      // Contributions: any household member with txn rights can append
      // (manual setoran or auto-debit run); immutable after create — the
      // bar chart is an audit trail, not editable history.
      match /goals/{goalId} {
        allow read: if isMember();
        allow write: if isMember() && canFull();

        match /contributions/{cid} {
          allow read: if isMember();
          allow create: if isMember() && canTxn();
          allow update, delete: if false;
        }
      }
      match /investments/{document=**} {
        allow read: if isMember();
        allow write: if isMember() && canFull();
      }

      // Net-worth daily snapshots. Doc id pinned to YYYY-MM-DD; any
      // signed-in member can record today's snapshot or read history.
      // No update/delete from the client — recorder is fire-and-forget;
      // tomorrow's run writes a new doc.
      match /netWorthSnapshots/{date} {
        allow read: if isMember();
        allow create, update: if isMember();
        allow delete: if false;
      }
    }

    // Invite codes: 6-digit, single-use. `get` allowed (so a joiner can
    // validate). `list` blocked — no enumeration. Only the generator can
    // create; they must mark it unconsumed. Consume = a single false→true
    // transition that binds `consumedBy` to the caller; immutable fields
    // (householdId, generatedBy, expiresAt) must stay unchanged.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.generatedBy
                    && request.resource.data.consumed == false;

      allow update: if request.auth != null
                    && resource.data.consumed == false
                    && request.resource.data.consumed == true
                    && request.resource.data.consumedBy == request.auth.uid
                    && request.resource.data.householdId == resource.data.householdId
                    && request.resource.data.generatedBy == resource.data.generatedBy
                    && request.resource.data.expiresAt == resource.data.expiresAt;

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.generatedBy;
    }
  }
}
